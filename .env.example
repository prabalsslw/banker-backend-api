# Copy to .env locally. Never commit .env.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/banker_db?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=1h
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
PII_LOOKUP_HMAC_KEY=DIFFERENT_BASE64_ENCODED_32_BYTE_KEY
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
